$minute = 15;
$limit = (60 * $minute); // 60 (seconds) = 1 Minutes
ini_set('memory_limit', '-1');
ini_set('max_execution_time', $limit);
set_time_limit($limit);

function recursiveScan($directory, &$entries_array = array())
{
    $handle = @opendir($directory);
    if ($handle) {
        while (($entry = readdir($handle)) !== false) {
            if ($entry == '.' || $entry == '..') {
                continue;
            }
            $entry = $directory . DIRECTORY_SEPARATOR . $entry;
            if (is_dir($entry) && is_readable($directory) && !is_link($directory)) {
                $entries_array = recursiveScan($entry, $entries_array);
            } elseif (is_file($entry) && is_readable($entry)) {
                $entries_array['file_writable'][] = $entry;
            } else {
                $entries_array['file_not_writable'][] = $entry;
            }
        }
        closedir($handle);
    }
    return $entries_array;
}

function sortByLastModified($files)
{
    @array_multisort(array_map('filemtime', $files), SORT_DESC, $files);
    return $files;
}

function getSortedByExtension($path, $ext)
{
    $result = recursiveScan($path);
    $fileWritable = $result['file_writable'];
    $fileWritable = $fileWritable ? sortByLastModified($fileWritable) : array();
    $sortedWritableFile = array();

    foreach ($fileWritable as $entry) {
        $pathinfo = strtolower(pathinfo($entry, PATHINFO_EXTENSION));
        if (in_array($pathinfo, $ext)) {
            $sortedWritableFile[] = $entry;
        }
    }
    return $sortedWritableFile;
}

function getFileTokens($filename)
{
    $fileContent = @file_get_contents($filename);
    if ($fileContent === false) return array();
    
    $fileContent = preg_replace('/<\?([^p=\w])/m', '<?php ', $fileContent); 
    $token = token_get_all($fileContent);
    $output = array();
    
    foreach ($token as $t) {
        if (isset($t[1])) {
            $output[] = strtolower(trim($t[1]));
        }
    }
    return array_values(array_unique(array_filter($output)));
}

$ext = array('php', 'phps', 'pht', 'phpt', 'phtml', 'phar', 'php3', 'php4', 'php5', 'php7', 'suspected');

// Kategori tingkat keparahan (Severity)
$criticalRisk = array('eval', 'exec', 'shell_exec', 'system', 'passthru', 'popen', 'proc_open', 'assert', 'create_function', 'pcntl_fork');
$warningRisk = array('base64_decode', 'str_rot13', 'gzinflate', 'gzuncompress', 'convert_uu', 'strrev', 'move_uploaded_file', 'file_put_contents', 'curl_init', 'fsockopen', '$_files', 'extract');
$infoRisk = array('phpinfo', 'posix_getuid', 'getenv', 'disk_free_space', 'disk_total_space', 'get_current_user', 'php_uname', 'mysql_connect', 'mysqli_connect', 'fopen', 'allow_url_fopen', 'ini_set');

$allNeedles = array_merge($criticalRisk, $warningRisk, $infoRisk);

$foundFiles = array();
if (isset($_POST['submit'])) {
    $path = $_POST['dir'];
    $scannedFiles = getSortedByExtension($path, $ext);
    
    if (!empty($scannedFiles)) {
        foreach ($scannedFiles as $file) {
            $filePath = str_replace('\\', '/', $file);
            $tokens = getFileTokens($filePath);
            
            // Cek token yang nyangkut
            $cmp = array_intersect($allNeedles, $tokens);
            
            if (!empty($cmp)) {
                // Tentukan level bahaya berdasarkan token yang ditemukan
                $severity = 'INFO';
                if (count(array_intersect($cmp, $criticalRisk)) > 0) {
                    $severity = 'CRITICAL';
                } elseif (count(array_intersect($cmp, $warningRisk)) > 0) {
                    $severity = 'WARNING';
                }

                $foundFiles[] = array(
                    'path' => $filePath,
                    'tokens' => implode(', ', $cmp),
                    'time' => filemtime($file),
                    'severity' => $severity
                );
            }
        }
    }
}
