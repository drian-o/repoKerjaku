    <script>
        function copyResults() {
            let paths = document.querySelectorAll('.js-path');
            if (paths.length === 0) return;
            
            let text = Array.from(paths).map(td => td.innerText).join('\n');
            let dummy = document.createElement('textarea');
            document.body.appendChild(dummy);
            dummy.value = text;
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);
            
            alert('Copied ' + paths.length + ' paths to clipboard!');
        }
